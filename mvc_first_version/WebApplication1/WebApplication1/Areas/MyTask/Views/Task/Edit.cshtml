@using WebApplication1.Areas.MyTask.DTO
@using WebApplication1.Areas.MyTask.Entities
@model TaskUpdateRequestDto

@{
    ViewData["Title"] = $"Изменить задачу #{ViewBag.TaskId}";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" asp-area="MyTask" method="post">
    <input type="hidden" name="id" value="@ViewBag.TaskId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<WebApplication1.Areas.MyTask.Entities.TaskStatus>()"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    @await Html.PartialAsync("_Form", Model)

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a class="btn btn-secondary" href="@Url.Action("Details", new { area = "MyTask", id = ViewBag.TaskId })">Отмена</a>
</form>

<partial name="_ValidationScriptsPartial" />
