@model IEnumerable<MyIdentityUserEntity>
@{ 
    Layout = "SneatAdminBoard/_ContentNavbarLayout";
    ViewData["Title"] = "Admin Dashboard";

    var page = Convert.ToInt32(ViewData["Page"] ?? 1);
    var pageSize = Convert.ToInt32(ViewData["PageSize"] ?? 10);
    var totalItems = Convert.ToInt32(ViewData["TotalItems"] ?? 0);
    var totalPages = Math.Max(1, (int)Math.Ceiling(totalItems / (double)Math.Max(1, pageSize)));
    if (page < 1) { page = 1; }
    if (page > totalPages) { page = totalPages; }
    var search = (ViewData["Search"] as string) ?? string.Empty;
    var rolesByUser = ViewBag.UserRoles as IDictionary<string, IList<string>> ?? new Dictionary<string, IList<string>>();
    var role = (ViewData["Role"] as string) ?? string.Empty;
    var allRoles = ViewBag.AllRoles as IEnumerable<string> ?? Enumerable.Empty<string>();
}


<div class="card">
    <h5 class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span>Admin Board : Users</span>
        <form method="get" class="d-flex align-items-center flex-wrap gap-2" role="search">
            <input type="hidden" name="pageSize" value="@(pageSize)" />
            <div class="input-group" style="width: 260px">
                <input class="form-control" type="search" placeholder="Поиск по email" aria-label="Поиск"
                       name="search" value="@search" />
            </div>

            <select name="role" class="form-select" style="width: 220px">
                <option value="">Все роли</option>
                @foreach (var r in allRoles)
                {
                    if (string.Equals(r, role, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@r" selected>@r</option>
                    }
                    else
                    {
                        <option value="@r">@r</option>
                    }
                }
            </select>

            <button class="btn btn-primary" type="submit">Применить</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Сбросить</a>
        </form>
    </h5>

    @if (TempData["StatusMessage"] is string msg && !string.IsNullOrWhiteSpace(msg))
    {
        <div class="alert alert-info alert-dismissible fade show mx-3 mt-3" role="alert">
            @msg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }



    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
            <tr>
                <th> Email Name</th>
                <th> Action </th>
            </tr>
            </thead>

            <tbody>
        
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Email<br/>
                        @user.UserName<br/>
                        @{
                            if (rolesByUser.TryGetValue(user.Id, out var roles) && roles.Any())
                            {
                                <div class="mt-1">
                                    @foreach (var r in roles)
                                    {
                                        <span class="badge bg-secondary me-1">@r</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small mt-1">Нет ролей</div>
                            }
                            var isLocked = user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow;
                            if (isLocked)
                            {
                                <div class="text-danger small mt-1">Заблокирован до @user.LockoutEnd.Value.LocalDateTime</div>
                            }
                        }
                    </td>
                    <td class="text-nowrap">
                        @{
                            var isLockedNow = user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow;
                        }
                        @{
                            var editUrl = Url.RouteUrl("AdminUsers_Edit", new { id = user.Id, page = page, pageSize = pageSize, search = search, role = role });
                        }
                        <a class="btn btn-sm btn-outline-primary me-1" href="@editUrl">Редактировать</a>
                        @if (!isLockedNow)
                        {
                            <form asp-controller="AdminUsers" asp-action="Lock" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <input type="hidden" name="page" value="@(page)" />
                                <input type="hidden" name="pageSize" value="@(pageSize)" />
                                <input type="hidden" name="search" value="@(search)" />
                                <input type="hidden" name="role" value="@(role)" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Заблокировать пользователя">
                                    Заблокировать
                                </button>
                            </form>
                        }
                        else
                        {
                            <form  asp-controller="AdminUsers"  asp-action="Unlock" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <input type="hidden" name="page" value="@(page)" />
                                <input type="hidden" name="pageSize" value="@(pageSize)" />
                                <input type="hidden" name="search" value="@(search)" />
                                <input type="hidden" name="role" value="@(role)" />
                                <button type="submit" class="btn btn-sm btn-success" title="Разблокировать пользователя">
                                    Разблокировать
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }


            </tbody>

            <tfoot>
            <tr>
                <td colspan="2">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            Всего пользователей: <strong>@totalItems</strong>
                        </div>

                        <form method="get" class="d-flex align-items-center gap-2">
                            <input type="hidden" name="page" value="@(page)" />
                            <input type="hidden" name="search" value="@search" />
                            <input type="hidden" name="role" value="@role" />
                            <label for="pageSize" class="me-2">На странице:</label>
                            <select id="pageSize" name="pageSize" class="form-select form-select-sm" 
                                    style="width: auto" onchange="this.form.submit()">
                                @{ var sizes = new int[] { 5, 10, 20, 50 }; }
                                @foreach (var sz in sizes)
                                {
                                    if (sz == pageSize)
                                    {
                                        <option value="@sz" selected>@sz</option>
                                    }
                                    else
                                    {
                                        <option value="@sz">@sz</option>
                                    }
                                }
                            </select>
                        </form>

                        <nav aria-label="Пагинация пользователей">
                            <ul class="pagination mb-0">
                                <li class="page-item @(page <= 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-page="@Math.Max(1, page - 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-role="@role" aria-label="Предыдущая">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>

                                @{
                                    // Показываем до 5 страниц вокруг текущей
                                    var start = Math.Max(1, page - 2);
                                    var end = Math.Min(totalPages, start + 4);
                                    // Сдвиг если близко к концу
                                    start = Math.Max(1, Math.Min(start, end - 4));
                                }

                                @for (int p = start; p <= end; p++)
                                {
                                    <li class="page-item @(p == page ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-role="@role">@p</a>
                                    </li>
                                }

                                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@Math.Min(totalPages, page + 1)" asp-route-pageSize="@pageSize" asp-route-search="@search" asp-route-role="@role" aria-label="Следующая">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </td>
            </tr>
            </tfoot>
        </table>

    </div>
</div>



